defaults:
  - override hydra/hydra_logging: none #colorlog
  - override hydra/job_logging: none # colorlog

hydra:
  job:
    chdir: true  # to save objects in a working directory
  run:
    dir: .  # Disable Hydra's Directory Change

modeling:
  random_seed: 42

# supported_models: ['GRU','TranAD','AnomalyTransformer', 'T-GCN','ST-GCN','A3TGCN','GDN','MTAD-GAT','STformer'] # 'USAD'
supported_models: ['GRU','A3TGCN']
supported_sliding_windows: [6, 12, 18, 24, 30]
# Graph-based models: the only ones null_padding_feature / null_padding_target apply to
graph_models: ['A3TGCN', 'GDN', 'GST_PRO', 'STGformer']

evaluation:
  retrain: false
  retest:  false
  re_calculate_mahalanobis: false
  mahalanobis_reference: 'train_valid'  # set the Mahalanobis mean/covariance are fitted on: 'train', 'valid', 'train_valid' (clean windows of both) or 'test'
  mahalanobis_covariance: 'ledoit_wolf'  # 'empirical', 'ledoit_wolf' (shrinkage) or 'pca' (Hotelling T² + SPE/Q)
  mahalanobis_min_variance: 1e-6         # drop dimensions whose reference variance is <= this before fitting
  mahalanobis_pca_variance: 0.95      # 'pca' only: share of variance kept in the principal subspace
  mahalanobis_pca_quantile: 0.99      # 'pca' only: quantile of T² / Q on the reference errors used to scale them
  top_k_contribution: 5
  use_model: 'STGformer' # 'A3TGCN' or 'GRU', 'GDN', 'TranAD', 'OmniAnomaly', 'USAD','MTAD-GAT','GST_PRO','AnomalyTransformer'
  null_padding_feature: true
  null_padding_target: false
  train_batch_size: 16 # 16  # training batch size
  evaluation_batch_size: 32
  slide_win: 6
  fill_nan: 'zero' # 'zero','mean', 'median'
  nab_scoring_profiles: [ "standard", "reward_fn" ] # Options: "standard", "reward_fn"
  model_save_path: "trained_models/"
  epochs: 30
  post_processing_strategies: ['likelihood', 'likelihood_mahalanobis', 'mean_reconstruction_errors']  # 'likelihood', 'likelihood_mahalanobis', 'mahalanobis', 'mean_reconstruction_errors'
  topks: [1,2,3,4,5, null]  # number of largest sensor scores averaged per timestamp; null = mean over all sensors (e.g. [1, null])
  # error normalisation before top-k: 'per_node' (median/IQR per node, as GDN does per sensor) or 'global' (one median/IQR
  # for all nodes). Training runs the scores and grid search for each; the ensemble / plotting / analysis scripts use the first
  score_normalizations: ['per_node', 'global']
  distribution_anomaly_thresholds: [99.5, 99.6, 99.7, 99.8, 99.9]
#  mahalanobis_anomaly_thresholds: [99.6, 99.7, 99.8]
  anomaly_thresholds: [0.998, 0.9985, 0.999, 0.9997, 0.99975, 0.9998]
  # Likelihood strategies: 'absolute' = likelihood > each anomaly_thresholds value (past scores only);
  # 'percentile' = above each distribution_anomaly_thresholds percentile of the split, like mahalanobis
  likelihood_threshold_mode: 'percentile'  # 'absolute' or 'percentile'
  long_windows: [30,40,50,60,70]
  short_windows: [2,3,4,5,6]
  ensembles:
#    http_codes: [ '5xx','4xx' ] # http codes can be 1xx, 2xx, 3xx, 4xx, 5xx
#    aggregations: [ 'count', 'avg', 'min', 'max' ]
    combination_mode: 'manual'        # ['auto', 'manual']
    auto_combination:
      num_selection: 7
      http_codes: ['5xx','4xx'] # http codes can be 1xx, 2xx, 3xx, 4xx, 5xx
      aggregations: ['count','avg','min', 'max']
    manual_combination:
#      http_codes: [ '5xx','4xx' ] # http codes can be 1xx, 2xx, 3xx, 4xx, 5xx
#      aggregations: [ 'count','min']
      http_codes: [ '5xx','4xx' ] # http codes can be 1xx, 2xx, 3xx, 4xx, 5xx
      aggregations: [ 'count','avg']

#  post_processing:
#    distance: 'mahala'
#    recreate: true
#    #    anomaly_thresholds: [99.5, 99.7, 99.8]
#    anomaly_thresholds: [99.8]

data_preparation_pipeline:
  grouping_mode: 'no_group'
  multiple_preprocessing: true
  reset_saved_data: false
  slide_win: ${evaluation.slide_win}
  null_padding_target: ${evaluation.null_padding_target}
  null_padding_feature: ${evaluation.null_padding_feature}
  fill_nan: ${evaluation.fill_nan}
  log_transform: true   # log1p of the counts before MinMax scaling; results go to <model_save_path>_log1p/
  train_valid_ratio: 0.8  # chronological share of the training period used for training; the rest is validation
  feature_subsets:
#    http_codes: ['5xx','4xx'] # http codes can be 1xx, 2xx, 3xx, 4xx, 5xx
#    aggregations: ['count','avg','min','max']
    http_codes: [ '5xx'] # http codes can be 1xx, 2xx, 3xx, 4xx, 5xx
    aggregations: ['count']
  features_prep:
    filter:
      http_codes: ['5xx'] # http codes can minbe 1xx, 2xx, 3xx, 4xx, 5xx
      aggregations: ['count'] # aggregations can be ['count', 'avg', 'min', 'max',' median', 'std', 'kurtosis', 'skewness']

  ground_truth_labels:
    path: "data/labels/"
    filename: "anomaly_windows.csv"

  input_file:
    path: "data/massaged/"
    filename: "pivoted_data_all.parquet"

  train_test_config:
    anomaly_window:
      minutes_before: 20
      minutes_after: 0  # Use Duration column values
    experiment_parameters:
      start_date: '2024-01-26' # Actual Satrt 26 Jan 2024
      train_end_date: '2024-02-29'
      test_start_date: '2024-03-01'
      end_date: '2024-05-31' # Actual End 31 May 2024

plotting:
  use_existing_file: False
  output_dir: 'plot_results'
  slide_win: ${evaluation.slide_win}
  model_save_path: "trained_models/"
  false_discovery_rate:
    models: ['GRU', 'A3TGCN']
    subsets:
      http_codes: ['5xx','4xx']
      aggregations: ['count', 'avg','min','max']
  null_padding_features: ${multiple_evaluation.null_padding_feature}
  null_padding_targets: ${multiple_evaluation.null_padding_target}
  fill_nan_values: ['zero','mean', 'median']
  nab_profiles: ['standard', 'low_fn']

multiple_evaluation:
  models: ['AnomalyTransformer'] # 'A3TGCN','GDN',
#  models: ['GRU']
  slide_wins: ${supported_sliding_windows}
#  slide_wins: [6]
  subsets:
    http_codes: [ '5xx']
#    http_codes: ['4xx']
    aggregations: [ 'count']
#    aggregations: ['count']
  fill_nan_values: ['zero','mean','median']
#  fill_nan_values: ['zero']
  null_padding_feature: [true]
  null_padding_target: [false]

model_configs:
  AnomalyTransformer:
    model_filename: 'AnomalyTransformer_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: false
    null_padding_feature: false
    score_mode: 'association'      # 'forecast' or 'association' (results go to AnomalyTransformer_<score_mode>/)
    score_temperature: 1.0      # τ in Softmax(-AssocDisc * τ), used only when score_mode == 'association'
  GST_PRO:
    model_filename: 'GST_PRO_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: ${evaluation.null_padding_target}
    null_padding_feature: ${evaluation.null_padding_feature}
  MTAD_GAT:
    model_filename: 'MTAD_GAT_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: false
    null_padding_feature: false
  USAD:
    model_filename: 'USAD_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: false
    null_padding_feature: false
  OmniAnomaly:
    model_filename: 'OmniAnomaly_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: false
    null_padding_feature: false
  TranAD:
    model_filename: 'TranAD_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: false
    null_padding_feature: false
  GDN:
    model_filename: 'GDN_model.pt'
    slide_win: ${evaluation.slide_win}
    null_padding_target: ${evaluation.null_padding_target}
    null_padding_feature: ${evaluation.null_padding_feature}
  STformer:
    model_filename: 'STformer_model.pt'
    slide_win: ${evaluation.slide_win}
  STGformer:
    model_filename: 'STGformer_model.pt'
    slide_win: ${evaluation.slide_win}
    # Graphs averaged over sliding windows of this many steps (official kernel_size): 1 = one graph per
    # step; slide_win = one graph shared by all steps, as the official code for large graphs (~2400 nodes
    # here). Results go to STGformer_pool<k>/ when > 1
    temporal_kernel_size: ${evaluation.slide_win}
    null_padding_target: ${evaluation.null_padding_target}
    null_padding_feature: ${evaluation.null_padding_feature}
  GRU:
    model_filename: 'GRU_autoencoder.h5'
    hidden_units: 64
    layer_dim: 3            # number of stacked GRU layers
    dropout: 0.0           # applied between GRU layers only, so it has no effect when layer_dim == 1
    learning_rate: 0.001   # Adam
    loss_function: "mse"
    null_padding_target: false
    null_padding_feature: false
    slide_win: ${evaluation.slide_win}
#    data_dir: "./trained_models/gru/"
  A3TGCN:
    model_filename: 'A3TGCN_autoencoder.pt'
    slide_win: ${evaluation.slide_win}
    shuffle_train: false
    data_dir: "./trained_models/a3tgcn/"
    null_padding_target: ${evaluation.null_padding_target}
    null_padding_feature: ${evaluation.null_padding_feature}
